.combat-document, .combat-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.combat-screen { color: rgb(237, 235, 220); }
.combat-panel { position: absolute; left: 0; right: 0; bottom: 16px; height: 74px; }
.combat-vitals { position: absolute; bottom: 0; width: 240px; }
.combat-vital { width: 240px; margin-bottom: 5px; }
.combat-vital-heading { flex-direction: row; justify-content: space-between; align-items: center; height: 16px; margin-bottom: 2px; }
.combat-vital-name { font-size: 11px; padding-left: 0; }
.combat-bar { width: 240px; height: 8px; flex-shrink: 0; background-color: rgba(12, 18, 23, 0.8); }
.combat-mp-track { background-color: rgb(24, 43, 76); }
.combat-fill { position: absolute; left: 0; top: 0; bottom: 0; }
.combat-hp { background-color: rgb(205, 55, 64); }
.combat-mp { background-color: rgb(46, 112, 219); }
.combat-value { flex-shrink: 0; font-size: 11px; padding-right: 0; -unity-text-align: middle-right; }
.combat-skills { position: absolute; right: 16px; bottom: -12.5px; width: 328px; height: 74px; }
.combat-slot { position: absolute; width: 56px; height: 74px; flex-shrink: 0; }
.combat-skill-icon { width: 56px; height: 56px; }
.combat-skill-art { position: absolute; left: 3px; right: 3px; top: 3px; bottom: 3px; }
.combat-key { position: absolute; left: 2px; top: 2px; height: 16px; padding-left: 3px; padding-right: 3px; font-size: 9px; color: rgb(237, 235, 220); background-color: rgba(10, 16, 22, .9); -unity-text-align: middle-center; }
.combat-mouse-shortcut { position: absolute; left: 2px; top: 2px; height: 18px; padding-left: 2px; padding-right: 2px; flex-direction: row; justify-content: center; align-items: center; background-color: rgba(10, 16, 22, .9); }
.combat-mouse-icon { width: 11px; height: 14px; flex-shrink: 0; }
.combat-mouse-sequence { width: 9px; height: 14px; padding-left: 0; padding-right: 0; font-size: 10px; color: rgb(175, 184, 191); -unity-text-align: middle-center; }
.combat-cooldown { position: absolute; left: 0; right: 0; top: 0; height: 56px; padding-left: 0; padding-right: 0; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-color: rgb(8, 12, 17); -unity-text-outline-width: 1px; color: rgb(255, 255, 255); }
.combat-lock { position: absolute; left: 18px; top: 19px; width: 20px; height: 20px; }
.combat-tooltip { position: absolute; width: 220px; padding-left: 8px; padding-right: 8px; padding-top: 5px; padding-bottom: 5px; font-size: 12px; color: rgb(237, 235, 220); background-color: rgba(12, 18, 25, .96); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(130, 121, 96); border-right-color: rgb(130, 121, 96); border-top-color: rgb(130, 121, 96); border-bottom-color: rgb(130, 121, 96); white-space: normal; display: none; }
.combat-effect { position: absolute; left: 0; right: 0; top: 60px; height: 14px; flex-direction: row; align-items: center; display: none; }
.combat-effect-label { width: 24px; height: 14px; padding-left: 0; padding-right: 0; font-size: 9px; color: rgb(131, 226, 206); -unity-text-align: middle-left; }
.combat-effect-track { flex-grow: 1; height: 3px; background-color: rgb(24, 51, 51); }
.combat-effect-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(94, 219, 193); }
