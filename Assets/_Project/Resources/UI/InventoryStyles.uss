.inventory-document, .inventory-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.inventory-screen { align-items: center; justify-content: center; background-color: rgba(12, 10, 8, 0.84); color: rgb(236, 230, 214); font-size: 14px; }
.inventory-panel { width: 94%; max-width: 1160px; height: 92%; padding: 16px; background-color: rgb(36, 38, 43); border-width: 2px; border-color: rgb(110, 102, 92); border-radius: 3px; }
.inventory-menu { width: 320px; padding: 28px; background-color: rgb(30, 31, 35); }
.inventory-menu > Button { margin-top: 18px; }
.inventory-header { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 12px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgb(184, 137, 60); }
.inventory-title { flex-grow: 1; font-size: 22px; -unity-font-style: bold; color: rgb(240, 212, 138); }
.inventory-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.equipment-pane { flex-grow: 4; flex-basis: 0; min-width: 0; min-height: 0; margin-right: 20px; padding: 10px; background-color: rgb(30, 31, 35); border-width: 1px; border-color: rgb(70, 64, 57); border-radius: 2px; }
.equipment-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.equipment-scroll .unity-scroll-view__content-container { flex-grow: 1; min-height: 100%; }
.equipment-scroll .unity-scroll-view__content-viewport, .bag-scroll .unity-scroll-view__content-viewport { min-width: 0; min-height: 0; overflow: hidden; }
.inventory-screen .unity-scroll-view__content-and-vertical-scroll-container { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; }
.inventory-screen .unity-scroll-view__content-viewport { flex-grow: 1; flex-shrink: 1; }
.inventory-screen .unity-scroll-view__vertical-scroller { width: 12px; min-width: 12px; flex-shrink: 0; margin-left: 4px; }
.inventory-screen .unity-scroller__low-button, .inventory-screen .unity-scroller__high-button { display: none; }
.inventory-screen .unity-scroller__slider { flex-grow: 1; min-height: 0; margin: 0; }
.inventory-screen .unity-base-slider__input, .inventory-screen .unity-base-slider__drag-container { flex-grow: 1; min-height: 0; }
.inventory-screen .unity-base-slider__drag-container { position: relative; }
.inventory-screen .unity-base-slider__tracker { position: absolute; left: 3px; right: 3px; top: 0; bottom: 0; background-color: rgb(30, 31, 35); }
.inventory-screen .unity-base-slider__dragger { position: absolute; left: 0; right: 0; min-height: 24px; background-color: rgb(140, 132, 118); border-radius: 4px; }
.inventory-screen .unity-base-slider__dragger:hover { background-color: rgb(196, 150, 70); }
.section-title { flex-shrink: 0; font-size: 16px; -unity-text-align: middle-center; margin-bottom: 10px; color: rgb(238, 231, 213); }
.equipment-layout { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; align-items: stretch; }
.equipment-column { width: 88px; flex-shrink: 0; justify-content: space-between; }
.character-preview { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; margin: 8px; }
.inventory-screen .equipment-slot { flex-grow: 1; flex-basis: 0; min-height: 52px; max-height: 104px; flex-shrink: 1; margin: 0; margin-bottom: 6px; padding: 7px; background-color: rgb(21, 22, 26); border-width: 0; border-radius: 2px; }
.equipment-slot > Image { flex-grow: 1; min-height: 0; }
.equipment-slot > Label { flex-shrink: 0; font-size: 11px; -unity-text-align: middle-center; min-height: 18px; padding-top: 2px; color: rgb(214, 206, 186); background-color: rgba(10, 10, 12, 0.6); border-radius: 2px; }
.set-status { flex-shrink: 0; margin-top: 8px; padding-top: 6px; border-top-width: 1px; border-top-color: rgb(92, 85, 76); font-size: 12px; white-space: normal; color: rgb(206, 194, 160); }
.bag-pane { flex-grow: 6; flex-basis: 0; min-width: 0; }
.category-tabs { flex-direction: row; flex-shrink: 0; }
.category-tab { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 4px; padding-left: 4px; padding-right: 4px; border-radius: 3px; }
.bag-capacity { margin-top: 8px; margin-bottom: 8px; font-size: 13px; color: rgb(196, 186, 164); }
.bag-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; background-color: rgb(18, 19, 22); border-width: 1px; border-color: rgb(70, 64, 57); padding: 3px; border-radius: 2px; }
.bag-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.inventory-screen .bag-cell { width: 96px; height: 96px; flex-shrink: 0; margin: 1px; padding: 6px; background-color: rgb(26, 27, 31); border-width: 0; border-radius: 2px; }
.bag-cell > Image { flex-grow: 1; min-height: 0; }
.stack-count { position: absolute; right: 4px; bottom: 2px; font-size: 13px; background-color: rgba(14, 12, 10, 0.85); }
.upgrade-level { position: absolute; right: 4px; top: 2px; font-size: 14px; color: rgb(255, 214, 126); background-color: rgba(14, 12, 10, 0.85); }
.quest-list { flex-grow: 1; padding: 20px; margin-top: 12px; background-color: rgb(40, 41, 46); }
.quest-title { font-size: 18px; margin-bottom: 16px; -unity-font-style: bold; }
.quest-empty { font-size: 14px; white-space: normal; color: rgb(196, 186, 164); }
.selection-panel { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 96px; margin-top: 12px; padding: 14px; background-color: rgb(30, 31, 35); border-width: 1px; border-color: rgb(70, 64, 57); border-radius: 2px; }
.selection-copy { flex-grow: 1; flex-shrink: 1; margin-right: 16px; }
.selection-title { font-size: 16px; margin-bottom: 6px; color: rgb(240, 212, 138); }
.selection-description { white-space: normal; font-size: 13px; }
.inventory-message { min-height: 22px; margin-top: 8px; flex-shrink: 0; white-space: normal; color: rgb(244, 207, 140); font-size: 13px; }
.inventory-screen Button { font-size: 14px; color: rgb(236, 235, 225); background-image: none; background-color: rgb(76, 71, 65); -unity-text-align: middle-center; border-width: 0; border-radius: 2px; }
.inventory-header > Button, .inventory-menu > Button, .category-tab, #equipment-action { min-height: 38px; padding: 8px; }
.inventory-header > Button, #equipment-action { min-width: 96px; border-radius: 2px; }
.inventory-screen Button:hover { background-color: rgb(106, 100, 90); }
.inventory-screen Button:disabled { color: rgb(140, 134, 122); background-color: rgb(46, 44, 41); }
.inventory-screen .selected { background-color: rgb(110, 84, 40); }
.inventory-screen .hidden { display: none; }
.inventory-screen.hidden { display: none; }
.equipment-drag-ghost { position: absolute; left: 0; top: 0; width: 80px; height: 80px; padding: 6px; background-color: rgba(30, 31, 35, 0.95); border-width: 2px; border-color: rgb(226, 196, 122); display: none; }
.equipment-drag-ghost > .upgrade-item-icon { flex-grow: 1; }
.inventory-screen .equipment-drag-source { opacity: 0.45; }
.inventory-screen .equipment-drop-valid { border-width: 2px; border-color: rgb(125, 209, 153); }
.inventory-screen .equipment-drop-invalid { border-width: 2px; border-color: rgb(220, 120, 112); }
