.inventory-document, .inventory-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.inventory-screen { align-items: center; justify-content: center; background-color: rgba(9, 13, 20, 0.86); color: rgb(235, 239, 245); font-size: 14px; }
.inventory-panel { width: 94%; max-width: 1160px; height: 92%; padding: 16px; background-color: rgb(24, 33, 46); }
.inventory-menu { width: 320px; padding: 28px; background-color: rgb(24, 33, 46); }
.inventory-menu > Button { margin-top: 18px; }
.inventory-header { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 12px; }
.inventory-title { flex-grow: 1; font-size: 22px; -unity-font-style: bold; }
.inventory-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.equipment-pane { flex-grow: 4; flex-basis: 0; min-width: 0; margin-right: 20px; padding: 10px; background-color: rgb(29, 40, 54); }
.equipment-scroll .unity-scroll-view__content-container { flex-grow: 1; min-height: 100%; }
.equipment-scroll .unity-scroll-view__content-viewport, .bag-scroll .unity-scroll-view__content-viewport { min-width: 0; min-height: 0; overflow: hidden; }
.inventory-screen .unity-scroll-view__content-and-vertical-scroll-container { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; }
.inventory-screen .unity-scroll-view__content-viewport { flex-grow: 1; flex-shrink: 1; }
.inventory-screen .unity-scroll-view__vertical-scroller { width: 12px; min-width: 12px; flex-shrink: 0; margin-left: 4px; }
.inventory-screen .unity-scroller__low-button, .inventory-screen .unity-scroller__high-button { display: none; }
.inventory-screen .unity-scroller__slider { flex-grow: 1; min-height: 0; margin: 0; }
.inventory-screen .unity-base-slider__input, .inventory-screen .unity-base-slider__drag-container { flex-grow: 1; min-height: 0; }
.inventory-screen .unity-base-slider__drag-container { position: relative; }
.inventory-screen .unity-base-slider__tracker { position: absolute; left: 3px; right: 3px; top: 0; bottom: 0; background-color: rgb(24, 33, 46); }
.inventory-screen .unity-base-slider__dragger { position: absolute; left: 0; right: 0; min-height: 24px; background-color: rgb(91, 115, 137); border-radius: 4px; }
.inventory-screen .unity-base-slider__dragger:hover { background-color: rgb(128, 153, 176); }
.section-title { flex-shrink: 0; font-size: 16px; -unity-text-align: middle-center; margin-bottom: 8px; }
.equipment-layout { flex-direction: row; flex-grow: 1; flex-shrink: 0; height: 336px; min-height: 336px; align-items: stretch; }
.equipment-column { width: 88px; flex-shrink: 0; justify-content: space-around; }
.character-preview { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; margin: 8px; }
.equipment-slot { height: 104px; flex-shrink: 0; margin: 0; margin-bottom: 8px; padding: 6px; }
.equipment-slot > Image { flex-grow: 1; min-height: 0; }
.equipment-slot > Label { flex-shrink: 0; font-size: 11px; -unity-text-align: middle-center; }
.set-status { flex-shrink: 0; margin-top: 10px; font-size: 12px; white-space: normal; color: rgb(203, 208, 179); }
.bag-pane { flex-grow: 6; flex-basis: 0; min-width: 0; }
.category-tabs { flex-direction: row; flex-shrink: 0; }
.category-tab { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 4px; padding-left: 4px; padding-right: 4px; }
.bag-capacity { margin-top: 8px; margin-bottom: 8px; font-size: 13px; color: rgb(184, 203, 220); }
.bag-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.bag-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.bag-cell { width: 96px; height: 96px; flex-shrink: 0; margin: 0; padding: 6px; background-color: rgb(37, 49, 65); border-width: 2px; border-color: rgb(24, 33, 46); }
.bag-cell > Image { flex-grow: 1; min-height: 0; }
.stack-count { position: absolute; right: 4px; bottom: 2px; font-size: 13px; background-color: rgba(12, 17, 24, 0.85); }
.upgrade-level { position: absolute; right: 4px; top: 2px; font-size: 14px; color: rgb(255, 214, 126); background-color: rgba(12, 17, 24, 0.85); }
.quest-list { flex-grow: 1; padding: 20px; margin-top: 12px; background-color: rgb(29, 40, 54); }
.quest-title { font-size: 18px; margin-bottom: 16px; -unity-font-style: bold; }
.quest-empty { font-size: 14px; white-space: normal; color: rgb(186, 200, 214); }
.selection-panel { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 96px; margin-top: 12px; padding: 12px; background-color: rgb(29, 40, 54); }
.selection-copy { flex-grow: 1; flex-shrink: 1; margin-right: 16px; }
.selection-title { font-size: 16px; margin-bottom: 6px; }
.selection-description { white-space: normal; font-size: 13px; }
.inventory-message { min-height: 22px; margin-top: 8px; flex-shrink: 0; white-space: normal; color: rgb(244, 207, 140); font-size: 13px; }
.inventory-screen Button { font-size: 14px; color: rgb(245, 247, 250); background-color: rgb(47, 67, 87); -unity-text-align: middle-center; border-width: 2px; border-color: rgb(66, 85, 103); }
.inventory-header > Button, .inventory-menu > Button, .category-tab, #equipment-action { min-height: 38px; padding: 8px; }
.inventory-screen Button:hover { background-color: rgb(66, 94, 118); }
.inventory-screen Button:disabled { color: rgb(150, 158, 166); background-color: rgb(42, 49, 59); }
.inventory-screen .selected { border-color: rgb(226, 196, 122); background-color: rgb(66, 77, 83); }
.inventory-screen .hidden { display: none; }
.inventory-screen.hidden { display: none; }
